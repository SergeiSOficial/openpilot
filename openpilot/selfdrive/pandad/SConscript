Import('env', 'arch', 'common', 'messaging')

if arch != "Darwin":
  import libusb

  panda_env = env.Clone()
  panda_env.Append(CPPPATH=[libusb.INCLUDE_DIR], LIBPATH=[libusb.LIB_DIR])
  libs = [common, messaging, 'pthread', 'usb-1.0']
  panda = panda_env.Library('panda', ['panda.cc', 'spi.cc', 'usb.cc'])

  panda_env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

  if GetOption('extras'):
    panda_env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
    panda_env.Program('tests/test_pandad_usb', ['tests/test_pandad_usb.cc'], LIBS=[panda, common, messaging, 'pthread'])
